{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "struktly/packet/v2",
  "title": "Struktly context packet",
  "description": "Repository files and guidance selected for one task.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "struktly/packet/v2"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "instruction_files": {
      "$ref": "#/$defs/strings"
    },
    "required_checks": {
      "$ref": "#/$defs/strings"
    },
    "suggested_checks": {
      "$ref": "#/$defs/strings"
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "truncations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "packet_hash": {
      "$ref": "#/$defs/hash"
    },
    "task": {
      "type": "string"
    },
    "direction": {
      "type": "string"
    },
    "constraints": {
      "type": "string"
    },
    "decisions": {
      "type": "string"
    },
    "verification_commands": {
      "$ref": "#/$defs/strings"
    },
    "docs": {
      "$ref": "#/$defs/strings"
    },
    "suggested_files": {
      "$ref": "#/$defs/strings"
    },
    "missing_context": {
      "$ref": "#/$defs/strings"
    },
    "read_warnings": {
      "$ref": "#/$defs/strings"
    },
    "source_refs": {
      "$ref": "#/$defs/strings"
    },
    "scope": {
      "type": "string",
      "description": "Repository-relative directory the request was narrowed to. Absent when the whole repository was considered. Part of packet identity."
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Starting paths the caller named, recorded whether or not each survived selection. Part of packet identity."
    }
  },
  "required": [
    "schema",
    "generated_at",
    "metadata",
    "repository",
    "items",
    "required_checks",
    "suggested_checks",
    "exclusions",
    "truncations",
    "limits",
    "packet_hash",
    "task",
    "verification_commands",
    "suggested_files",
    "source_refs"
  ],
  "additionalProperties": true,
  "$defs": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "declared",
            "detected",
            "inferred",
            "uncertain"
          ]
        }
      },
      "required": [
        "source",
        "method",
        "confidence"
      ],
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "absolute_git_root": {
          "type": "string"
        }
      },
      "required": [
        "generated_at",
        "absolute_git_root"
      ],
      "additionalProperties": true
    },
    "repository": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "identity": {
          "type": "string"
        },
        "vcs": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "head_revision": {
          "type": "string"
        },
        "base_revision": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "identity",
        "vcs",
        "root",
        "head_revision"
      ],
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "reason": {
          "type": "string"
        },
        "rendering": {
          "enum": [
            "declarations"
          ],
          "description": "Form of `content` when it is not verbatim source. Absent means verbatim. \"declarations\" means function bodies were omitted to fit the byte budget, so a body-less function must not be read as one that does nothing."
        },
        "original_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "included_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "path",
        "content",
        "content_hash",
        "provenance",
        "reason",
        "original_bytes",
        "included_bytes",
        "truncated"
      ],
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "additionalProperties": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 0
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_items",
        "max_file_bytes",
        "max_total_bytes"
      ],
      "additionalProperties": true
    }
  }
}
